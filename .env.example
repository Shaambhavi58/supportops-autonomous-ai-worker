# Offline deterministic mode. No API key or network access is needed.
DEMO_MODE=true
SUPPORTOPS_DB_PATH=data/supportops.sqlite3
APPROVAL_THRESHOLD=50
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.05

# Optional OpenAI-compatible planning. Set DEMO_MODE=false to enable.
LLM_API_KEY=replace-with-your-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20